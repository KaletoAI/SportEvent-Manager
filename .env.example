# SportAbo Manager — Konfiguration
# Kopieren nach .env und Werte setzen. NIE ins Repo committen.

# Pflicht in Produktion (App startet sonst nicht):
# Generieren mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Domain für Caddy/TLS (Hetzner: A-Record auf die Server-IP zeigen lassen)
DOMAIN=sportabo.example.com

# Öffentliche Basis-URL für Links in E-Mails (Prod: https://DOMAIN,
# Dev z. B. http://<lan-ip>:8000)
BASE_URL=https://sportabo.example.com

# "production" erzwingt sichere Konfiguration, "dev" erlaubt Defaults
APP_ENV=production

# Secure-Flag für Cookies — true hinter HTTPS (Caddy), false nur lokal
COOKIE_SECURE=true

# Optional: SMTP für Abrechnungs-E-Mails (leer = kein Versand)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
